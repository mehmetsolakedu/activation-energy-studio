    "verify:scientific-review-handoff:v0.3.2": "node scripts/build-scientific-review-handoff-v0.3.2.mjs --check && node output/v0.3.2-external-validation/scientific-review/Activation-Energy-Studio-Scientific-Review-Handoff-v0.3.2/VERIFY_PACKAGE.mjs",
    "build:platform-validation-kit:v0.3.2": "node scripts/generate-platform-validation-package-v032.mjs",
