{
  "name": "activation-energy-studio",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "description": "Offline apparent activation-energy analysis for multi-rate thermoanalytical data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release-manifest": "node --test tests/release-manifest.test.mjs",
    "test:fixture-manifest": "node --test tests/fixture-manifest.test.mjs",
    "test:offline-verifier": "node --test tests/offline-bundle-verifier.test.mjs",
    "package:v0.4.1": "npm run build && npm run verify:offline && node scripts/package-v0.4.1-release.mjs && npm run verify:release-manifest:v0.4.1",
    "package:v0.4.0": "npm run verify:release-manifest:v0.4.0",
    "package:v0.3.2": "npm run verify:release-manifest:v0.3.2",
    "release:manifest": "npm run package:v0.4.1",
    "verify:offline": "node scripts/verify-offline-bundle.mjs",
    "verify:production-sbom": "node scripts/verify-production-sbom.mjs",
    "verify:fixture-manifest": "node scripts/generate-fixture-manifest.mjs --check",
    "verify:release-manifest": "npm run verify:release-manifest:v0.4.1",
    "verify:release-manifest:v0.4.1": "node scripts/verify-release-package.mjs --manifest release/v0.4.1/MANIFEST.v0.4.1.json --checksum release/v0.4.1/SHA256SUMS.v0.4.1.txt --version 0.4.1",
    "verify:release-manifest:v0.4.0": "node scripts/verify-release-package.mjs --manifest release/v0.4.0/MANIFEST.v0.4.0.json --checksum release/v0.4.0/SHA256SUMS.v0.4.0.txt --version 0.4.0",
    "verify:release-manifest:v0.3.2": "node scripts/verify-release-package.mjs --manifest release/v0.3.2/MANIFEST.v0.3.2.json --checksum release/v0.3.2/SHA256SUMS.v0.3.2.txt --version 0.3.2",
    "verify:release-manifest:v0.3.1": "node scripts/verify-release-package.mjs --manifest release/v0.3.1/MANIFEST.v0.3.1.json --checksum release/v0.3.1/SHA256SUMS.v0.3.1.txt --version 0.3.1",
    "check": "npm run typecheck && npm test && npm run test:fixture-manifest && npm run test:offline-verifier && npm run test:release-manifest && npm run verify:fixture-manifest && npm run verify:production-sbom && npm run verify:release-manifest:v0.4.1 && npm run verify:release-manifest:v0.4.0 && npm run verify:release-manifest:v0.3.2 && npm run verify:release-manifest:v0.3.1 && npm run build && npm run verify:offline"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "papaparse": "5.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "^8.18.0",
    "jsdom": "29.1.1",
    "puppeteer-core": "25.3.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.15"
  }
}
