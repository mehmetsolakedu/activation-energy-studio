{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "activation-energy-studio/known-issues/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseVersion",
    "ledgerState",
    "policy",
    "sourceLocks",
    "issues",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "activation-energy-studio/known-issues/v1"
    },
    "releaseVersion": {
      "const": "0.2.0"
    },
    "ledgerState": {
      "const": "OPEN_BLOCKERS_RETAINED_NOT_VALIDATED_MVP"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severityOrder",
        "priorityOrder",
        "blockingStates",
        "validatedMvpBlockingSeverities",
        "rule",
        "externalGateBoundary"
      ],
      "properties": {
        "severityOrder": {
          "const": [
            "CRITICAL",
            "MAJOR",
            "MINOR",
            "INFO"
          ]
        },
        "priorityOrder": {
          "const": [
            "P0",
            "P1"
          ]
        },
        "blockingStates": {
          "const": [
            "OPEN"
          ]
        },
        "validatedMvpBlockingSeverities": {
          "const": [
            "CRITICAL",
            "MAJOR"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 40
        },
        "externalGateBoundary": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "sourceLocks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/definitions/fileLock"
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/issue"
      }
    },
    "summary": {
      "$ref": "#/definitions/summary"
    }
  },
  "definitions": {
    "fileLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "priority",
        "state",
        "blockerClass",
        "blocksValidatedMvp",
        "externalGate",
        "acceptanceCriteria",
        "evidencePaths",
        "statement",
        "closureCondition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^KI-[A-Z]+-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 12
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "MAJOR",
            "MINOR",
            "INFO"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1"
          ]
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "DOCUMENTED_NEGATIVE"
          ]
        },
        "blockerClass": {
          "enum": [
            "EXTERNAL_EVIDENCE",
            "SCIENTIFIC_EVIDENCE_BOUNDARY",
            "PUBLICATION_METHOD_BOUNDARY",
            "CORPUS_IDENTITY_BOUNDARY",
            "SOFTWARE_DEFECT"
          ]
        },
        "blocksValidatedMvp": {
          "type": "boolean"
        },
        "externalGate": {
          "type": "boolean"
        },
        "acceptanceCriteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AC-[A-Z]+-[0-9]{2}$"
          }
        },
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          }
        },
        "statement": {
          "type": "string",
          "minLength": 40
        },
        "closureCondition": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "countBySeverity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "INFO"
      ],
      "properties": {
        "CRITICAL": {
          "type": "integer",
          "minimum": 0
        },
        "MAJOR": {
          "type": "integer",
          "minimum": 0
        },
        "MINOR": {
          "type": "integer",
          "minimum": 0
        },
        "INFO": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "countByPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P0",
        "P1"
      ],
      "properties": {
        "P0": {
          "type": "integer",
          "minimum": 0
        },
        "P1": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "countByState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OPEN",
        "CLOSED",
        "DOCUMENTED_NEGATIVE"
      ],
      "properties": {
        "OPEN": {
          "type": "integer",
          "minimum": 0
        },
        "CLOSED": {
          "type": "integer",
          "minimum": 0
        },
        "DOCUMENTED_NEGATIVE": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "bySeverity",
        "byPriority",
        "byState",
        "openCriticalOrMajorIds",
        "unresolvedP0Ids",
        "validatedMvpEligible",
        "releaseReadiness"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "bySeverity": {
          "$ref": "#/definitions/countBySeverity"
        },
        "byPriority": {
          "$ref": "#/definitions/countByPriority"
        },
        "byState": {
          "$ref": "#/definitions/countByState"
        },
        "openCriticalOrMajorIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^KI-[A-Z]+-[0-9]{3}$"
          }
        },
        "unresolvedP0Ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^KI-[A-Z]+-[0-9]{3}$"
          }
        },
        "validatedMvpEligible": {
          "type": "boolean"
        },
        "releaseReadiness": {
          "enum": [
            "ELIGIBLE_FOR_SEPARATE_HUMAN_RELEASE_DECISION",
            "BLOCKED_BY_OPEN_CRITICAL_MAJOR_OR_P0_ISSUES"
          ]
        }
      }
    }
  }
}
